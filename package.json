{
  "name": "puddle",
  "version": "0.0.0",
  "description": "Fund private balances with an ordinary token transfer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blmalone/puddle.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "rename": "node scripts/rename.ts",
    "dev": "npm run build:ui && npm run recovery:build && node scripts/dev.ts",
    "dev:app": "npm run build:ui && node scripts/local-app.ts",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:typecheck": "tsc --noEmit -p docs/tsconfig.json",
    "build:ui": "tsc -p app/tsconfig.json && node scripts/build-version.ts",
    "test:ui": "npm run build:ui && node --test test/local-app.test.ts",
    "recovery:build": "tsc -p app/tsconfig.json && tsc -p recovery/tsconfig.json && node scripts/build-recovery.ts",
    "recovery:dev": "npm run recovery:build && node scripts/serve-recovery.ts",
    "test:recovery": "npm run recovery:build && node --test test/recovery.test.ts",
    "setup": "node scripts/setup.ts",
    "setup:contracts": "node scripts/setup-foundry.ts",
    "test:contracts": "forge test",
    "test": "node --test --test-concurrency=1 test/deposit.test.ts",
    "test:fork": "node --test test/fork.test.ts",
    "privacy-pools:setup": "npm --prefix test/privacy-pools ci --ignore-scripts && node test/privacy-pools/setup.ts",
    "test:privacy-pools": "npm --prefix test/privacy-pools run typecheck && npm --prefix test/privacy-pools test",
    "demo": "node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run docs:typecheck && npm run test:contracts && npm test && npm run test:ui && npm run test:recovery && npm run docs:build"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "@railgun-community/engine": "9.8.0",
    "circomlibjs": "0.1.7",
    "ethers": "6.17.0",
    "solc": "0.8.17"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "bn.js@^4": "4.12.3",
    "form-data@^2": "2.5.6",
    "qs@^6": "6.16.0",
    "ws@^8": "8.21.0",
    "ws@^5": "5.2.5",
    "solc": {
      "tmp": "0.2.7"
    },
    "simple-get@^2": "2.8.2"
  }
}
